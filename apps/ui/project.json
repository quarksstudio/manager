{
  "name": "ui",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/ui/src",
  "projectType": "application",
  "tags": ["type:app", "scope:manager"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["build-antd-css"],
      "options": {
        "command": "astro build",
        "cwd": "apps/ui"
      },
      "outputs": ["{workspaceRoot}/dist/apps/ui"]
    },
    "build-antd-css": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "production",
        "^production",
        "{workspaceRoot}/tools/build-web-antd-css.mjs",
        "{workspaceRoot}/tools/build-web-antd-css.entry.tsx"
      ],
      "options": {
        "command": "node tools/build-web-antd-css.mjs"
      },
      "outputs": ["{workspaceRoot}/apps/ui/public/antd.css"]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --test test/*.spec.mjs",
        "cwd": "apps/ui"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "dependsOn": ["build-antd-css"],
      "options": {
        "command": "astro dev",
        "cwd": "apps/ui"
      }
    },
    "preview": {
      "executor": "nx:run-commands",
      "options": {
        "command": "astro preview",
        "cwd": "apps/ui"
      }
    },
    "check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "astro check",
        "cwd": "apps/ui"
      }
    },
    "desktop": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm run desktop",
        "cwd": "apps/ui"
      }
    },
    "desktop:pack": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm run desktop:pack",
        "cwd": "apps/ui"
      }
    }
  }
}
