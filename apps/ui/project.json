{
  "name": "ui",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/ui/src",
  "projectType": "application",
  "tags": ["type:app", "scope:manager"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "astro build",
        "cwd": "apps/ui"
      },
      "outputs": ["{workspaceRoot}/dist/apps/ui"]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --test test/*.spec.mjs",
        "cwd": "apps/ui"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "astro dev",
        "cwd": "apps/ui"
      }
    },
    "preview": {
      "executor": "nx:run-commands",
      "options": {
        "command": "astro preview",
        "cwd": "apps/ui"
      }
    },
    "check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "astro check",
        "cwd": "apps/ui"
      }
    },
    "desktop": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm run desktop",
        "cwd": "apps/ui"
      }
    },
    "desktop:pack": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm run desktop:pack",
        "cwd": "apps/ui"
      }
    }
  }
}