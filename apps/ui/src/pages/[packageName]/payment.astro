---
import {
  PricingModeNav,
  ConfiguredPricingBoundary as PricingBoundary,
  ConfiguredPlanGrid as PlanGrid,
} from '@quarks.studio/commerce/web';

import Layout from '../../layouts/Layout.astro';
import { registryBaseUrl } from '../../lib/registry-base';
import { packageUrl, getPackage } from '../../lib/registry';

const name = decodeURIComponent(Astro.params.packageName ?? '');
const mode =
  Astro.url.searchParams.get('mode') === 'products' ? 'products' : 'plans';

await getPackage(Astro.cookies, name).catch((e) => Astro.rewrite('/404'));
---

<Layout title={`Plans · ${name}`}>
  <main class="mx-auto w-full max-w-6xl px-4 py-8">
    <h1 class="text-2xl font-semibold text-slate-900">Plans for {name}</h1>
    <p class="mt-1 text-sm text-slate-500">
      An active subscription adds monthly credit to {name}. Every renewal
      charges the listed amount.
    </p>

    <div class="mt-4">
      <PricingModeNav
        client:load
        mode={mode}
        baseUrl={packageUrl(name, undefined) + '/payment'}
      />
    </div>
    <PricingBoundary
      apiBaseUrl={registryBaseUrl}
      client:only="react"
      mode="plans"
      packageName={name}
    />
  </main>
</Layout>
