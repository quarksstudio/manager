---
import { ConfiguredPackagesBoundary as PackagesBoundary } from '@quarks.studio/distribution/web';
import Layout from '../../layouts/Layout.astro';
import { registryBaseUrl as browserRegistryBaseUrl } from '../../lib/registry-base';

const name = decodeURIComponent(Astro.params.packageName ?? '');
---

<Layout title={name}>
  <PackagesBoundary
    apiBaseUrl={browserRegistryBaseUrl}
    client:only="react"
    packageName={name}
  />
</Layout>
