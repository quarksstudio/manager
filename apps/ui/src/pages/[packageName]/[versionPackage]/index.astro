---
import { ConfiguredPackagesBoundary } from '@quarks.studio/distribution/web';

import { registryBaseUrl as browserRegistryBaseUrl } from '../../../lib/registry-base';
import Layout from '../../../layouts/Layout.astro';

const name = decodeURIComponent(Astro.params.packageName ?? '');
const versionSt = decodeURIComponent(Astro.params.versionPackage ?? '');
---

<Layout title={`${name} · ${versionSt}`}>
  <ConfiguredPackagesBoundary
    apiBaseUrl={browserRegistryBaseUrl}
    client:only="react"
    packageName={name}
    version={versionSt}
  />
</Layout>
