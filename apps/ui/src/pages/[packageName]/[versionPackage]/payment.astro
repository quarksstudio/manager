---
import { loadConfig } from '@quarks.studio/config';
import { PricingModeNav } from '@quarks.studio/commerce/web';
import {
  ConfiguredTierMatrix as TierMatrix,
  ConfiguredPricingBoundary as PricingBoundary,
} from '@quarks.studio/commerce/web';

import Layout from '../../../layouts/Layout.astro';
import { registryBaseUrl } from '../../../lib/registry-base';
import { packageUrl, getPackage } from '../../../lib/registry';

const name = decodeURIComponent(Astro.params.packageName ?? '');
const versionSt = decodeURIComponent(Astro.params.versionPackage ?? '');
const { detail, version } = await getPackage(
  Astro.cookies,
  name,
  versionSt,
).catch((e) => Astro.rewrite('/404'));

const mode =
  Astro.url.searchParams.get('mode') === 'plans' ? 'plans' : 'products';
---

<Layout title={`Certifications · ${name} ${version}`}>
  <main class="mx-auto w-full max-w-6xl px-4 py-8">
    <h1 class="text-2xl font-semibold text-slate-900">
      Certifications of {name}
      {version}
    </h1>

    <div class="mt-4">
      <PricingModeNav
        client:load
        mode={mode}
        baseUrl={`${packageUrl(name, version)}/payment`}
      />
    </div>

    <PricingBoundary
      apiBaseUrl={registryBaseUrl}
      client:only="react"
      mode={mode}
      packageName={name}
      versionId={version}
    />
  </main>
</Layout>
