---
import UserAccountLayout from '../../../layouts/UserAccountLayout.astro';
import { ConfiguredIntegrationsSettingsDashboard } from '@quarks.studio/identity/web';
import { registryBaseUrl } from '../../../lib/registry-base';
import { getUser } from '../../../lib/registry';

const username = decodeURIComponent(Astro.params.username ?? '');
const user = await getUser(Astro.cookies, username).catch((e) =>
  Astro.rewrite('/404'),
);
---

<UserAccountLayout
  title={`AI Integrations // ${username} // Quark`}
  description="Configure your AI integrations."
  username={username}
  profileId={user.id}
  active="integrations"
>
  <ConfiguredIntegrationsSettingsDashboard
    username={username}
    apiBaseUrl={registryBaseUrl}
    client:only="react"
  />
</UserAccountLayout>
