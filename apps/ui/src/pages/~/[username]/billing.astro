---
import { ConfiguredBillingBoundary } from '@quarks.studio/commerce/web';
import UserAccountLayout from '../../../layouts/UserAccountLayout.astro';
import { registryBaseUrl } from '../../../lib/registry-base';
import { getUser } from '../../../lib/registry';

const username = decodeURIComponent(Astro.params.username ?? '');
const user = await getUser(Astro.cookies, username).catch((e) =>
  Astro.rewrite('/404'),
);

Astro.response.headers.set('Cache-Control', 'private, no-store');
---

<UserAccountLayout
  title="Purchases · Quark // Skills"
  description="Review purchases and subscription details for your Quark account."
  username={username}
  profileId={user.id}
  active="billing"
>
  <ConfiguredBillingBoundary client:only="react" apiBaseUrl={registryBaseUrl} />
</UserAccountLayout>
