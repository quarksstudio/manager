---
import Layout from '../../../layouts/Layout.astro';
import { ConfiguredUserProfile as UserProfile } from '@quarks.studio/identity/web';
import { registryBaseUrl } from '../../../lib/registry-base';
import { getUser } from '../../../lib/registry';

const username = decodeURIComponent(Astro.params.username ?? '');
await getUser(Astro.cookies, username).catch((e) => Astro.rewrite('/404'));
---

<Layout
  title={`${username} // Quark`}
  description={`Packages published by ${username} on Quark.`}
>
  <UserProfile
    username={username}
    apiBaseUrl={registryBaseUrl}
    client:only="react"
  />
</Layout>
