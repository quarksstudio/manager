---
import UserAccountLayout from '../../../layouts/UserAccountLayout.astro';
import { ConfiguredUserProfile } from '@quarks.studio/identity/web';
import { registryBaseUrl } from '../../../lib/registry-base';
import { getUser } from '../../../lib/registry';

const username = decodeURIComponent(Astro.params.username ?? '');
const user = await getUser(Astro.cookies, username).catch((e) =>
  Astro.rewrite('/404'),
);
---

<UserAccountLayout
  title={`${username} // Quark`}
  description={`Packages published by ${username} on Quark.`}
  username={username}
  profileId={user.id}
  active="profile"
>
  <ConfiguredUserProfile
    username={username}
    apiBaseUrl={registryBaseUrl}
    client:only="react"
  />
</UserAccountLayout>
