---
import {
  ConfiguredPlanGrid as PlanGrid,
  ConfiguredPricingBoundary as PricingBoundary,
  PricingModeNav,
} from '@quarks.studio/commerce/web';

import Layout from '../../layouts/Layout.astro';
import { registryBaseUrl } from '../../lib/registry-base';

const mode =
  Astro.url.searchParams.get('mode') === 'plans' ? 'plans' : 'products';
---

<Layout title="Pricing · Quark // Skills">
  <main class="mx-auto w-full max-w-6xl px-4 py-8">
    <h1 class="text-2xl font-semibold text-slate-900">Pricing</h1>
    <p class="mt-1 text-sm text-slate-500">
      Certifications per level and monthly support plans. The catalog is global:
      there is no package to sign up for here.
    </p>

    <div class="mt-4">
      <PricingModeNav client:load mode={mode} baseUrl="/pricing" />
    </div>

    <PricingBoundary
      apiBaseUrl={registryBaseUrl}
      client:only="react"
      mode={mode}
    />
  </main>
</Layout>
