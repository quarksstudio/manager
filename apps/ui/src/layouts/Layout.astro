---
import {
  SiteFooter,
  SiteNavbar,
  type SiteFooterLink,
} from '@quarks.studio/web-ui';
import { ConfiguredUserAvatarMenu as UserAvatarMenu } from '@quarks.studio/identity/web';
import { NotificationHost } from '@quarks.studio/notifications/web';
import '../styles.css';

const blogUrl = 'https://blog.quarks.studio';
const defaultFooterLinks: SiteFooterLink[] = [
  { label: 'Documentation', href: 'https://docs.quarks.studio' },
  { label: 'Pricing', href: '/~/pricing' },
  { label: 'Legal', href: 'https://docs.quarks.studio/terms' },
  { label: 'Blog', href: blogUrl },
];
interface Props {
  title: string;
  description?: string;
  navbarLogo?: string;
  searchAction?: string;
  searchPlaceholder?: string;
  searchValue?: string;
  loginUrl?: string;
  footerLinks?: SiteFooterLink[];
}
const {
  title,
  description = 'Formal Certification and Secure Distribution for AI Skills',
  navbarLogo = 'QUARK // SKILLS',
  searchAction = '/',
  searchPlaceholder = 'Search packages and skills...',
  searchValue = Astro.url.searchParams.get('query') ??
    Astro.url.searchParams.get('search') ??
    Astro.url.searchParams.get('q') ??
    '',
  loginUrl = '/login',
  footerLinks = defaultFooterLinks,
} = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="stylesheet" href="/antd.css" />
    <title>{title}</title>
  </head>
  <body class="flex min-h-screen flex-col bg-slate-950 text-slate-100">
    <NotificationHost client:only="react" />
    <SiteNavbar
      logo={navbarLogo}
      searchAction={searchAction}
      searchPlaceholder={searchPlaceholder}
      searchValue={searchValue}
      loginUrl={loginUrl}
    >
      <UserAvatarMenu client:only="react" />
    </SiteNavbar>
    <div class="flex-1">
      <slot />
    </div>
    <SiteFooter links={footerLinks} />
  </body>
</html>
