{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["jest", "node"],
    "esModuleInterop": true
  },
  "include": [
    "jest.config.cts",
    "test/**/*.test.ts",
    "test/**/*.spec.ts",
    "src/**/*.d.ts",
    "test/**/*.tsx"
  ]
}
