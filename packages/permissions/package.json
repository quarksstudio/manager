{
  "name": "@quarks.studio/permissions",
  "version": "0.2.0",
  "private": false,
  "license": "MIT",
  "type": "commonjs",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "require": "./src/index.js",
      "default": "./src/index.js"
    },
    "./domain": {
      "types": "./src/domain/index.d.ts",
      "require": "./src/domain/index.js",
      "default": "./src/domain/index.js"
    },
    "./lib": {
      "types": "./src/lib/index.d.ts",
      "require": "./src/lib/index.js",
      "default": "./src/lib/index.js"
    }
  },
  "files": [
    "**/*.js",
    "**/*.d.ts",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@quarks.studio/manifest": "workspace:*",
    "tslib": "^2.3.0"
  }
}
