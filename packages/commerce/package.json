{
  "name": "@quarks.studio/commerce",
  "version": "0.2.0",
  "private": false,
  "license": "MIT",
  "type": "commonjs",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "require": "./src/index.js",
      "default": "./src/index.js"
    },
    "./http": {
      "types": "./src/http.d.ts",
      "require": "./src/http.js",
      "default": "./src/http.js"
    },
    "./react": {
      "types": "./src/react.d.ts",
      "require": "./src/react.js",
      "default": "./src/react.js"
    },
    "./web": {
      "types": "./src/web/index.d.ts",
      "import": "./src/web/index.mjs",
      "default": "./src/web/index.mjs"
    }
  },
  "files": [
    "**/*.js",
    "**/*.d.ts",
    "**/*.mjs",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@quarks.studio/types": "workspace:*",
    "tslib": "^2.3.0",
    "@quarks.studio/logger": "workspace:*",
    "@quarks.studio/use-storage": "workspace:*",
    "@quarks.studio/web-ui": "workspace:*",
    "antd": "^6.6.5",
    "@ant-design/icons": "^6.3.4"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  }
}
