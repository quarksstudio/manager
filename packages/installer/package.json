{
  "name": "@quarks.studio/installer",
  "version": "0.2.0",
  "private": false,
  "license": "MIT",
  "type": "commonjs",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "require": "./src/index.js",
      "default": "./src/index.js"
    },
    "./CLI": {
      "types": "./src/CLI/index.d.ts",
      "import": "./src/CLI/index.mjs",
      "default": "./src/CLI/index.mjs"
    },
    "./hooks": {
      "types": "./src/hooks/index.d.ts",
      "require": "./src/hooks/index.js",
      "default": "./src/hooks/index.js"
    },
    "./application": {
      "types": "./src/application/index.d.ts",
      "require": "./src/application/index.js",
      "default": "./src/application/index.js"
    },
    "./domain": {
      "types": "./src/domain/index.d.ts",
      "require": "./src/domain/index.js",
      "default": "./src/domain/index.js"
    },
    "./lib": {
      "types": "./src/lib/index.d.ts",
      "require": "./src/lib/index.js",
      "default": "./src/lib/index.js"
    },
    "./presentation": {
      "types": "./src/presentation/index.d.ts",
      "require": "./src/presentation/index.js",
      "default": "./src/presentation/index.js"
    }
  },
  "files": [
    "**/*.js",
    "**/*.d.ts",
    "README.md",
    "**/*.mjs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@quarks.studio/domain-kernel": "workspace:*",
    "@quarks.studio/logger": "workspace:*",
    "@quarks.studio/manifest": "workspace:*",
    "@quarks.studio/permissions": "workspace:*",
    "@quarks.studio/storage": "workspace:*",
    "@quarks.studio/targz": "workspace:*",
    "@quarks.studio/terminal-ui": "workspace:*",
    "ink": "^7.0.2",
    "react": "^19.0.0",
    "semver": "7.8.5",
    "tar": "^7.4.3",
    "tslib": "^2.3.0"
  }
}
