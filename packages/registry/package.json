{
  "name": "@quarks.studio/registry",
  "version": "0.2.0",
  "private": false,
  "license": "MIT",
  "type": "commonjs",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "require": "./src/index.js",
      "default": "./src/index.js"
    },
    "./http": {
      "types": "./src/http.d.ts",
      "require": "./src/http.js",
      "default": "./src/http.js"
    },
    "./domain": {
      "types": "./src/domain/index.d.ts",
      "require": "./src/domain/index.js",
      "default": "./src/domain/index.js"
    },
    "./transport": {
      "types": "./src/transport/index.d.ts",
      "require": "./src/transport/index.js",
      "default": "./src/transport/index.js"
    }
  },
  "files": [
    "**/*.js",
    "**/*.d.ts",
    "README.md",
    "**/*.mjs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {}
}
