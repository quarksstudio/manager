{
  "name": "registry",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/registry/src",
  "projectType": "library",
  "tags": [
    "type:adapter",
    "scope:registry"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build-lib",
        "build-web"
      ],
      "outputs": [
        "{workspaceRoot}/dist/packages/registry"
      ],
      "cache": true,
      "inputs": [
        "production",
        "^production",
        "{workspaceRoot}/tools/build-cli.mjs"
      ],
      "options": {
        "command": "node tools/build-cli.mjs registry"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "options": {
        "jestConfig": "packages/registry/jest.config.cts"
      }
    },
    "build-lib": {
      "executor": "@nx/js:tsc",
      "outputs": [
        "{options.outputPath}"
      ],
      "dependsOn": [
        "^build"
      ],
      "options": {
        "outputPath": "dist/packages/registry",
        "main": "packages/registry/src/index.ts",
        "tsConfig": "packages/registry/tsconfig.lib.json",
        "assets": [
          "packages/registry/*.md"
        ]
      }
    },
    "build-web": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "build-lib"
      ],
      "outputs": [
        "{workspaceRoot}/dist/packages/registry/src/web/index.mjs"
      ],
      "cache": true,
      "inputs": [
        "production",
        "^production",
        "{workspaceRoot}/tools/build-functional-web.mjs"
      ],
      "options": {
        "command": "node tools/build-functional-web.mjs registry"
      }
    }
  }
}
