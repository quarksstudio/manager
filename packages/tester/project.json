{
  "name": "tester",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/tester/src",
  "projectType": "library",
  "tags": ["type:context", "scope:certification"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["build-lib"],
      "outputs": ["{workspaceRoot}/dist/packages/tester"],
      "cache": true,
      "inputs": [
        "production",
        "^production",
        "{workspaceRoot}/tools/build-cli.mjs"
      ],
      "options": {
        "command": "node tools/build-cli.mjs tester"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "packages/tester/jest.config.cts"
      }
    },
    "build-lib": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/packages/tester",
        "main": "packages/tester/src/index.ts",
        "tsConfig": "packages/tester/tsconfig.lib.json",
        "generatePackageJson": true,
        "assets": ["packages/tester/*.md", "packages/tester/package.json"]
      }
    }
  }
}
