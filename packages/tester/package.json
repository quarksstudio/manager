{
  "name": "@quarks.studio/tester",
  "version": "0.2.0",
  "private": false,
  "license": "MIT",
  "type": "commonjs",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "require": "./src/index.js",
      "default": "./src/index.js"
    },
    "./CLI": {
      "types": "./src/CLI/index.d.ts",
      "import": "./src/CLI/index.mjs",
      "default": "./src/CLI/index.mjs"
    },
    "./application": {
      "types": "./src/application/index.d.ts",
      "require": "./src/application/index.js",
      "default": "./src/application/index.js"
    },
    "./infrastructure": {
      "types": "./src/infrastructure/index.d.ts",
      "require": "./src/infrastructure/index.js",
      "default": "./src/infrastructure/index.js"
    },
    "./lib": {
      "types": "./src/lib/index.d.ts",
      "require": "./src/lib/index.js",
      "default": "./src/lib/index.js"
    }
  },
  "bin": {
    "quark-tester": "./src/cli.js"
  },
  "files": [
    "**/*.js",
    "**/*.d.ts",
    "README.md",
    "**/*.mjs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "fast-check": "^4.3.0",
    "tar": "^7.4.3",
    "tslib": "^2.3.0",
    "yaml": "^2.9.0",
    "zod": "^3.25.76",
    "@quarks.studio/config": "workspace:*",
    "ink": "^7.0.2",
    "@quarks.studio/terminal-ui": "workspace:*",
    "@quarks.studio/certification": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  }
}
