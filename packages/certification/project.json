{
  "name": "certification",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/certification/src",
  "projectType": "library",
  "tags": ["type:context", "scope:certification"],
  "targets": {
    "build": {
      "executor": "nx:noop",
      "dependsOn": ["build-lib"],
      "outputs": ["{workspaceRoot}/dist/packages/certification"],
      "cache": true,
      "inputs": ["production", "^production"]
    },
    "test": {
      "executor": "@nx/jest:jest",
      "options": {
        "jestConfig": "packages/certification/jest.config.cts"
      }
    },
    "build-lib": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/packages/certification",
        "main": "packages/certification/src/index.ts",
        "tsConfig": "packages/certification/tsconfig.lib.json",
        "assets": ["packages/certification/*.md"]
      }
    }
  }
}
