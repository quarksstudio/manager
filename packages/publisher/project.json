{
  "name": "publisher",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/publisher/src",
  "projectType": "library",
  "tags": ["type:context", "scope:publication"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["build-lib"],
      "outputs": ["{workspaceRoot}/dist/packages/publisher"],
      "cache": true,
      "inputs": [
        "production",
        "^production",
        "{workspaceRoot}/tools/build-cli.mjs"
      ],
      "options": {
        "command": "node tools/build-cli.mjs publisher"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "packages/publisher/jest.config.cts"
      }
    },
    "build-lib": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/packages/publisher",
        "main": "packages/publisher/src/index.ts",
        "tsConfig": "packages/publisher/tsconfig.lib.json",
        "assets": ["packages/publisher/*.md"]
      }
    }
  }
}
