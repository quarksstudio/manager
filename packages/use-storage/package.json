{
  "name": "@quarks.studio/use-storage",
  "version": "0.2.0",
  "private": false,
  "license": "MIT",
  "type": "commonjs",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "require": "./src/index.js",
      "default": "./src/index.js"
    },
    "./storage": {
      "types": "./src/storage.d.ts",
      "require": "./src/storage.js",
      "default": "./src/storage.js"
    },
    "./query": {
      "types": "./src/query.d.ts",
      "require": "./src/query.js",
      "default": "./src/query.js"
    }
  },
  "files": [
    "**/*.js",
    "**/*.d.ts",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "tslib": "^2.3.0",
    "@quarks.studio/types": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "browser": {
    "./src/node-adapter.ts": "./src/node-adapter.browser.ts",
    "./src/node-adapter.js": "./src/node-adapter.browser.js"
  }
}
