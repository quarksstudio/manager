{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": true,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "paths": {
      "@quarks.studio/types": ["./packages/types/src/index.ts"],
      "@quarks.studio/types/*": ["./packages/types/src/*"],
      "@quarks.studio/config": ["./packages/config/src/index.ts"],
      "@quarks.studio/registry": ["./packages/registry/src/index.ts"],
      "@quarks.studio/manifest": ["./packages/manifest/src/index.ts"],
      "@quarks.studio/installer": ["./packages/installer/src/index.ts"],
      "@quarks.studio/runtime": ["./packages/runtime/src/index.ts"],
      "@quarks.studio/permissions": ["./packages/permissions/src/index.ts"],
      "@quarks.studio/local-store": ["./packages/local-store/src/index.ts"],
      "@quarks.studio/logger": ["./packages/logger/src/index.ts"],
      "@quarks.studio/logger/*": ["./packages/logger/src/*"],
      "@quarks.studio/use-storage": ["./packages/use-storage/src/index.ts"],
      "@quarks.studio/targz": ["./packages/targz/src/index.ts"],
      "@quarks.studio/tester": ["./packages/tester/src/index.ts"],
      "@quarks.studio/publisher": ["./packages/publisher/src/index.ts"],
      "@quarks.studio/registry/upload": [
        "./packages/registry/src/infrastructure/upload-package-archive.ts"
      ],
      "@quarks.studio/installer/CLI": ["./packages/installer/src/CLI/index.ts"],
      "@quarks.studio/registry/CLI": ["./packages/registry/src/CLI/index.ts"],
      "@quarks.studio/config/CLI": ["./packages/config/src/CLI/index.ts"],
      "@quarks.studio/local-store/CLI": [
        "./packages/local-store/src/CLI/index.ts"
      ],
      "@quarks.studio/publisher/CLI": ["./packages/publisher/src/CLI/index.ts"],
      "@quarks.studio/tester/CLI": ["./packages/tester/src/CLI/index.ts"],
      "@quarks.studio/ui/CLI": ["./packages/ui/src/CLI/index.ts"],
      "@quarks.studio/ui/hooks": ["./packages/ui/src/hooks/index.ts"],
      "@quarks.studio/ui/web": ["./packages/ui/src/web/index.ts"],
      "@quarks.studio/ui/web/styles.css": ["./packages/ui/src/web/styles.css"],
      "ink": ["./node_modules/ink/build/index.d.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
