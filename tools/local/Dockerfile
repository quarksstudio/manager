FROM node:24.14.0-bookworm-slim
RUN corepack enable && corepack prepare pnpm@11.21.0 --activate
RUN apt-get update && apt-get install -y --no-install-recommends python3 tar ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /quark/cli
ENV CI=true
# Context is the standalone artifact generated by pnpm build:cli:local.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY patches/ ./patches/
RUN --mount=type=cache,id=quark-cli-pnpm,target=/pnpm/store pnpm install --prod --frozen-lockfile --store-dir=/pnpm/store
COPY main.js README.md local-cli.mjs ./
ENTRYPOINT ["node", "main.js"]
